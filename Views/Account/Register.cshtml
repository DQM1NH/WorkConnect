
@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản - WorkConnect";
}

<link rel="stylesheet" href="~/css/register.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="register-container">
    <h2 class="page-title">Tham gia ngay hôm nay</h2>

    <div class="register-card">
        <div class="left-panel">
            <div class="feature-item">
                <div class="feature-icon icon-blue">
                    <i class="fa-solid fa-bell"></i>
                </div>
                <div class="feature-text">
                    <h3>THÔNG BÁO VIỆC LÀM</h3>
                    <p>Được cập nhật các cơ hội việc làm mới nhất từ nhiều công ty hàng đầu</p>
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-icon icon-green">
                    <i class="fa-solid fa-money-bill-wave"></i>
                </div>
                <div class="feature-text">
                    <h3>KIẾM VIỆC DỄ DÀNG</h3>
                    <p>Tìm được công việc bạn yêu thích phù hợp với kỹ năng và tiêu chí bạn quan tâm</p>
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-icon icon-orange">
                    <i class="fa-solid fa-paper-plane"></i>
                </div>
                <div class="feature-text">
                    <h3>ỨNG TUYỂN NHANH CHÓNG</h3>
                    <p>Dễ dàng ứng tuyển nhiều vị trí mà không cần mất nhiều thời gian</p>
                </div>
            </div>
        </div>

        <div class="right-panel">
            <div class="tab-header">
                <a asp-action="Login" class="tab-item">ĐĂNG NHẬP</a>
                <a asp-action="Register" class="tab-item active">ĐĂNG KÝ</a>
            </div>

            <form asp-action="Register" method="post" class="register-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <h3>Loại tài khoản<span class="required-asterisk"> *</span></h3>
                <div class="form-group">
                    <select asp-for="Role" id="Role" class="form-control">
                        <option value="Candidate">Ứng viên</option>
                        <option value="Employer">Nhà tuyển dụng</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FirstName" class="register-field-label">Tên<span class="required-asterisk"> *</span></label>
                    <input asp-for="FirstName" class="form-control" placeholder="Nhập tên" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName" class="register-field-label">Họ và tên lót<span class="required-asterisk"> *</span></label>
                    <input asp-for="LastName" class="form-control" placeholder="Nhập họ và tên lót" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="register-field-label">Email<span class="required-asterisk"> *</span></label>
                    <input asp-for="Email" class="form-control" placeholder="Nhập email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group password-group">
                    <label asp-for="Password" class="register-field-label">Mật khẩu<span class="required-asterisk"> *</span></label>
                    <input asp-for="Password" type="password" id="Password"
                           class="form-control" placeholder="Nhập mật khẩu" />
                    <i class="fa-regular fa-eye-slash toggle-password"
                       onclick="togglePasswordVisibility('Password', this)"></i>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group password-group">
                    <label asp-for="ConfirmPassword" class="register-field-label">Xác nhận mật khẩu<span class="required-asterisk"> *</span></label>
                    <input asp-for="ConfirmPassword" type="password" id="ConfirmPassword"
                           class="form-control" placeholder="Nhập lại mật khẩu" />
                    <i class="fa-regular fa-eye-slash toggle-password"
                       onclick="togglePasswordVisibility('ConfirmPassword', this)"></i>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div id="employerFields" style="display:none;">
                    <hr />
                    <h3>Thông tin công ty</h3>

                    <div class="form-group">
                        <label asp-for="TenCongTy" class="register-field-label">Tên công ty<span class="required-asterisk"> *</span></label>
                        <input asp-for="TenCongTy" class="form-control employer-required"
                               placeholder="Nhập tên công ty" />
                        <span asp-validation-for="TenCongTy" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DiaChiCongTy" class="register-field-label">Địa chỉ công ty<span class="required-asterisk"> *</span></label>
                        <input asp-for="DiaChiCongTy" class="form-control employer-required"
                               placeholder="Nhập địa chỉ công ty" />
                        <span asp-validation-for="DiaChiCongTy" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="SoDienThoaiCongTy" class="register-field-label">Số điện thoại liên hệ công ty<span class="required-asterisk"> *</span></label>
                        <input asp-for="SoDienThoaiCongTy" class="form-control employer-required"
                               placeholder="Nhập số điện thoại công ty"
                               type="tel" />
                        <span asp-validation-for="SoDienThoaiCongTy" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input asp-for="WebsiteCongTy" class="form-control"
                               placeholder="Website công ty (ví dụ: https://example.com)" />
                        <span asp-validation-for="WebsiteCongTy" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MaNganhNghe">* Ngành nghề công ty</label>
                        <label asp-for="MaNganhNghe" class="register-field-label">Ngành nghề công ty<span class="required-asterisk"> *</span></label>
                        <select asp-for="MaNganhNghe" class="form-control employer-required">
                            <option value="">-- Chọn ngành nghề --</option>
                            <option value="1">Công nghệ thông tin</option>
                            <option value="2">Kế toán - Kiểm toán</option>
                            <option value="3">Marketing</option>
                            <option value="4">Kinh doanh - Bán hàng</option>
                            <option value="5">Thiết kế - Sáng tạo</option>
                            <option value="6">Giáo dục - Đào tạo</option>
                            <option value="7">Nhân sự</option>
                            <option value="8">Logistics - Vận tải</option>
                        </select>
                        <span asp-validation-for="MaNganhNghe" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MaQuyMo">Quy mô công ty</label>
                        <select asp-for="MaQuyMo" class="form-control">
                            <option value="">-- Chọn quy mô (không bắt buộc) --</option>
                            <option value="1">Nhỏ</option>
                            <option value="2">Vừa</option>
                            <option value="3">Lớn</option>
                        </select>
                        <span asp-validation-for="MaQuyMo" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="GioiThieuCongTy" class="register-field-label">Giới thiệu công ty<span class="required-asterisk"> *</span></label>
                        <textarea asp-for="GioiThieuCongTy" class="form-control"
                                  rows="4" placeholder="* Giới thiệu công ty"></textarea>
                        <span asp-validation-for="GioiThieuCongTy" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group checkbox-group">
                    <label class="custom-checkbox">
                        <input type="checkbox" asp-for="AgreeTerms" />
                        <span class="checkmark"></span>
                        <span class="terms-text">
                            <span class="required-asterisk">*</span>
                            Tôi xác nhận đã được thông báo về việc xử lý thông tin cá nhân của mình theo
                            <b>Thông báo về việc xử lý dữ liệu cá nhân</b> của WorkConnect.
                            Tôi đồng thời xác nhận đã đọc, hiểu, và đồng ý cung cấp thông tin cá nhân
                            và đồng ý với việc xử lý dữ liệu cá nhân của mình theo
                            <a href="#">Điều Khoản Sử Dụng</a> và
                            <a href="#">Chính Sách Quyền Riêng Tư</a> của WorkConnect.
                        </span>
                    </label>
                    <span asp-validation-for="AgreeTerms" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-submit">ĐĂNG KÝ</button>
            </form>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, iconElement) {
        const input = document.getElementById(inputId);

        if (input.type === "password") {
            input.type = "text";
            iconElement.classList.remove("fa-eye-slash");
            iconElement.classList.add("fa-eye");
        } else {
            input.type = "password";
            iconElement.classList.remove("fa-eye");
            iconElement.classList.add("fa-eye-slash");
        }
    }

    function toggleEmployerFields() {
        const roleSelect = document.getElementById("Role");
        const employerFields = document.getElementById("employerFields");
        const isEmployer = roleSelect.value === "Employer";

        employerFields.style.display = isEmployer ? "block" : "none";

        // Trường bị ẩn sẽ không bắt buộc nhập và không gửi lên server.
        employerFields.querySelectorAll("input, select, textarea").forEach(function (field) {
            field.disabled = !isEmployer;
        });

        employerFields.querySelectorAll(".employer-required").forEach(function (field) {
            field.required = isEmployer;
        });
    }

    document.getElementById("Role").addEventListener("change", toggleEmployerFields);
    toggleEmployerFields();
</script>
