@model WorkConnect.ViewModels.ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }

<div class="container mt-5" style="max-width: 450px;">
    <h3 class="text-center mb-3">Quên mật khẩu</h3>
    <form asp-action="ForgotPassword" method="post">
        <div class="mb-3">
            <label class="form-label">Nhập Email tài khoản</label>
            <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Gửi mã OTP</button>
    </form>
</div>