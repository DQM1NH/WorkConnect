
@model WorkConnect.Models.Employer.EmployerDashboardViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Tổng quan nhà tuyển dụng";
    ViewData["UseEmployerLayout"] = true;
}

<div class="container-fluid py-4">
    <h2 class="mb-1">Tổng quan</h2>
    <p class="text-muted">Tình hình tuyển dụng của công ty bạn.</p>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card p-3 h-100">
                <div class="text-muted">Tổng tin</div>
                <h2>@Model.TotalJobs</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 h-100">
                <div class="text-muted">Đang tuyển</div>
                <h2>@Model.RecruitingJobs</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 h-100">
                <div class="text-muted">Chờ duyệt</div>
                <h2>@Model.PendingJobs</h2>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 h-100">
                <div class="text-muted">Hết hạn</div>
                <h2>@Model.ExpiredJobs</h2>
            </div>
        </div>
    </div>

    <div class="card p-3 mb-4">
        <div class="text-muted">Tổng hồ sơ ứng tuyển</div>
        <h2>@Model.TotalApplications</h2>
    </div>

    <style>
        /* Tăng cỡ chữ chung riêng cho nội dung dashboard */
        .employer-main .container-fluid { font-size: 16px; }
        .employer-main .container-fluid > h2 { font-size: 28px; font-weight: 700; }
        .employer-main .container-fluid > p { font-size: 16px; }
        .employer-main .card .text-muted { font-size: 15px; }
        .employer-main .card h2 { font-size: 28px; }
        .employer-main .table { font-size: 15px; }
        .employer-main .table thead th { font-size: 14px; }
        .dashboard-job-status { display:inline-block; padding:6px 10px; border-radius:999px; font-size:14px; font-weight:700; white-space:nowrap; background:#eef1f5; color:#475467; border:1px solid #d8dee8; }
        .dashboard-job-status[data-status*="đang tuyển" i], .dashboard-job-status[data-status*="đạt" i], .dashboard-job-status[data-status*="đã duyệt" i], .dashboard-job-status[data-status*="đã đăng" i] { background:#e4f3e8; color:#267342; border-color:#b7dfc5; }
        .dashboard-job-status[data-status*="chờ duyệt" i], .dashboard-job-status[data-status*="chờ" i] { background:#fff2d7; color:#8a6414; border-color:#f0d58e; }
        .dashboard-job-status[data-status*="hết hạn" i], .dashboard-job-status[data-status*="từ chối" i], .dashboard-job-status[data-status*="đã đóng" i] { background:#fde8e7; color:#b42318; border-color:#f4b8b4; }
        .dashboard-job-status[data-status*="bản nháp" i] { background:#eaf0f8; color:#456181; border-color:#cbd8e8; }
        .dashboard-job-status[data-status*="đã gửi" i] { background:#e7f0ff; color:#2457a7; border-color:#bfd5ff; }
    </style>

    <div class="card p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Tin tuyển dụng gần đây</h5>
            <a asp-controller="Employer"
               asp-action="Jobs"
               class="btn btn-outline-primary btn-sm">
                Xem tất cả
            </a>
        </div>

        @if (Model.RecentJobs.Count == 0)
        {
            <p class="text-muted mb-0">
                Công ty chưa có tin tuyển dụng nào.
            </p>
            <div class="mt-3">
                <a asp-controller="Employer"
                   asp-action="Create"
                   class="btn btn-primary">
                    Đăng tin mới
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Mã tin</th>
                            <th>Tiêu đề</th>
                            <th>Ngày đăng</th>
                            <th>Hạn ứng tuyển</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model.RecentJobs)
                        {
                            <tr>
                                <td>#@job.MaTin</td>
                                <td>@job.TieuDe</td>
                                <td>@job.NgayDang.ToString("dd/MM/yyyy")</td>
                                <td>@job.HanUngTuyen.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="dashboard-job-status" data-status="@job.TrangThai">
                                        @job.TrangThai
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
