
@model WorkConnect.Models.Employer.CandidateSearchViewModel

@{
    ViewData["Title"] = "Tìm kiếm ứng viên";
    ViewData["UseEmployerLayout"] = true;
}

<div class="container mt-4 mb-5 candidate-search-page">
    <h2>Tìm kiếm ứng viên</h2>
    <p class="text-muted">
        Tìm ứng viên theo từ khóa, chuyên ngành, kỹ năng và kinh nghiệm.
    </p>

    <form asp-controller="Employer"
          asp-action="SearchCandidates"
          method="get"
          class="card card-body mb-4" id="candidate-search-form">

        <div class="row g-3">
            <div class="col-md-6">
                <label for="keyword" class="form-label">Từ khóa</label>
                <input id="keyword"
                       name="keyword"
                       value="@Model.Keyword"
                       class="form-control"
                       placeholder="Tên ứng viên, trường học..." />
            </div>

            <div class="col-md-6">
                <label for="chuyenNganh" class="form-label">Chuyên ngành</label>
                <select id="chuyenNganh"
                        name="chuyenNganh"
                        class="form-select">
                    <option value="">-- Tất cả chuyên ngành --</option>
                    @foreach (var major in Model.ChuyenNganhOptions)
                    {
                        if (Model.ChuyenNganh == major)
                        {
                            <option value="@major" selected>@major</option>
                        }
                        else
                        {
                            <option value="@major">@major</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label for="kyNang" class="form-label">Kỹ năng</label>
                <input id="kyNang"
                       name="kyNang"
                       value="@Model.KyNang"
                       class="form-control"
                       placeholder="Ví dụ: C#, SQL, Java" />
            </div>

            <div class="col-md-6">
                <label for="kinhNghiem" class="form-label">Kinh nghiệm</label>
                <input id="kinhNghiem"
                       name="kinhNghiem"
                       value="@Model.KinhNghiem"
                       class="form-control"
                       placeholder="Ví dụ: 1 năm, thực tập..." />
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Tìm kiếm
            </button>

            <a asp-controller="Employer"
               asp-action="SearchCandidates"
               class="btn btn-outline-secondary">
                Xóa bộ lọc
            </a>
        </div>
    </form>

    <div id="candidate-search-message" class="small text-muted mb-2" aria-live="polite"></div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Danh sách ứng viên</h4>
        <span class="text-muted" id="candidate-count">Tìm thấy @Model.Candidates.Count ứng viên</span>
    </div>

    @if (Model.Candidates.Count == 0)
    {
        <div class="alert alert-info">
            Không tìm thấy ứng viên phù hợp. Bạn hãy thử thay đổi điều kiện tìm kiếm.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Họ tên</th>
                        <th>Chuyên ngành</th>
                        <th>Trường học</th>
                        <th>Kỹ năng</th>
                        <th>Kinh nghiệm</th>
                        <th>Địa điểm</th>
                        <th>Trình độ</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="candidate-results">
                    @foreach (var candidate in Model.Candidates)
                    {
                        <tr>
                            <td>@candidate.HoTen</td>
                            <td>@candidate.ChuyenNganh</td>
                            <td>@candidate.Truong</td>
                            <td>@candidate.KyNang</td>
                            <td>@(string.IsNullOrWhiteSpace(candidate.KinhNghiem)
                                ? "Chưa cập nhật"
                                : candidate.KinhNghiem)</td>
                            <td>@(candidate.DiaDiem?.TenDiaDiem ?? "Chưa cập nhật")</td>
                            <td>@(candidate.TrinhDo?.TenTrinhDo ?? "Chưa cập nhật")</td>
                            <td>
                                <a asp-controller="Employer"
                                asp-action="CandidateDetails"
                                asp-route-id="@candidate.MaUngVien"
                                class="btn btn-sm btn-primary">
                                    Xem hồ sơ
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script>
$(function () {
    let timer;
    const form = $('#candidate-search-form');
    const message = $('#candidate-search-message');
    const results = $('#candidate-results');
    const count = $('#candidate-count');
    function esc(value) { return $('<div>').text(value == null ? '' : value).html(); }
    function searchCandidates() {
        message.text('Đang tìm kiếm...');
        $.ajax({
            url: '@Url.Action("SearchCandidatesAjax", "Employer")',
            type: 'GET', data: form.serialize(), dataType: 'json'
        }).done(function (response) {
            if (!response || !response.success) { message.text('Không thể tìm ứng viên.'); return; }
            count.text('Tìm thấy ' + response.count + ' ứng viên');
            if (!response.candidates.length) {
                results.html('<tr><td colspan="8" class="text-center text-muted">Không tìm thấy ứng viên phù hợp.</td></tr>');
            } else {
                results.html(response.candidates.map(function (c) {
                    return '<tr><td>' + esc(c.hoTen) + '</td><td>' + esc(c.chuyenNganh) + '</td><td>' + esc(c.truong) + '</td><td>' + esc(c.kyNang) + '</td><td>' + esc(c.kinhNghiem || 'Chưa cập nhật') + '</td><td>' + esc(c.diaDiem) + '</td><td>' + esc(c.trinhDo) + '</td><td><a class="btn btn-sm btn-primary" href="/Employer/CandidateDetails/' + c.id + '">Xem hồ sơ</a></td></tr>';
                }).join(''));
            }
            message.text('Kết quả đã cập nhật bằng AJAX.');
        }).fail(function () { message.text('Có lỗi khi tìm kiếm. Vui lòng thử lại.'); });
    }
    form.on('input', 'input', function () { clearTimeout(timer); timer = setTimeout(searchCandidates, 350); });
    form.on('change', 'select', searchCandidates);
    form.on('submit', function (e) { e.preventDefault(); clearTimeout(timer); searchCandidates(); });
    form.on('click', 'a.btn-outline-secondary', function (e) {
        e.preventDefault(); form[0].reset(); searchCandidates();
    });
});
</script>
}
