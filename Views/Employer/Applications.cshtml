@model IEnumerable<WorkConnect.Models.Entities.DonUngTuyen>

@{
    ViewData["Title"] = "Hồ sơ ứng tuyển";
    ViewData["UseEmployerLayout"] = true;
    var tieuDeTin = ViewBag.TieuDeTin as string ?? "Tin tuyển dụng";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Hồ sơ ứng tuyển</h2>
            <p class="text-muted mb-0">@tieuDeTin</p>
        </div>

        <a asp-controller="Employer" asp-action="Jobs" class="btn btn-outline-secondary">
            Quay lại danh sách tin
        </a>
    </div>

    <div id="ajax-review-message" class="alert d-none" role="status" aria-live="polite"></div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

        <div class="row g-2 mb-3 align-items-end">
            <div class="col-sm-5 col-md-4">
                <label for="application-status-filter" class="form-label">Lọc hồ sơ theo trạng thái</label>
                <select id="application-status-filter" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="1">Đã gửi</option><option value="2">Đang xem xét</option>
                    <option value="3">Mời phỏng vấn</option><option value="4">Đạt</option><option value="5">Từ chối</option>
                </select>
            </div>
            <div class="col-auto"><span id="application-filter-message" class="small text-muted" aria-live="polite"></span></div>
        </div>
    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">
                Danh sách hồ sơ
                <span class="badge bg-primary">@(Model?.Count() ?? 0)</span>
            </h5>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info mb-0">Chưa có ứng viên nộp hồ sơ cho tin tuyển dụng này</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Ứng viên</th>
                                <th>Thông tin liên hệ</th>
                                <th>Ngày nộp</th>
                                <th>Trạng thái</th>
                                <th>CV</th>
                                <th style="min-width: 320px;">Xét duyệt</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var stt = 0;
                            }

                            @foreach (var don in Model)
                            {
                                stt++;
                                <tr data-application-status="@don.MaTrangThai">
                                    <td>@stt</td>
                                    <td>
                                        <strong>
                                            @(!string.IsNullOrWhiteSpace(don.HoTen)
                                                ? don.HoTen
                                                : don.UngVien?.HoTen ?? "Chưa cập nhật")
                                        </strong>

                                        <div class="small text-muted">
                                            Mã ứng viên: @don.MaUngVien
                                        </div>
                                    </td>

                                    <td>
                                        <div>
                                            @(!string.IsNullOrWhiteSpace(don.Email)
                                                ? don.Email
                                                : don.UngVien?.EmailLienHe ?? "Chưa có email")
                                        </div>

                                        <div class="small text-muted">
                                            @(!string.IsNullOrWhiteSpace(don.SoDienThoai)
                                                ? don.SoDienThoai
                                                : don.UngVien?.SoDienThoaiLienHe ?? "Chưa có số điện thoại")
                                        </div>
                                    </td>

                                    <td>
                                        @don.NgayNop.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <span id="status-@don.MaDon" class="badge
                                            @(don.MaTrangThai == 4 ? "bg-success" :
                                              don.MaTrangThai == 5 ? "bg-danger" :
                                              don.MaTrangThai == 3 ? "bg-info text-dark" :
                                              don.MaTrangThai == 2 ? "bg-warning text-dark" :
                                              "bg-secondary")">
                                            @(don.TrangThai?.TenTrangThai ?? "Chưa xác định")
                                        </span>
                                    </td>

                                    <td>
                                        @if (don.CV != null &&
                                             !string.IsNullOrWhiteSpace(don.CV.DuongDanTep))
                                        {
                                            <span>@don.CV.TenTep</span>
                                            <div>
                                                <a href="@don.CV.DuongDanTep" target="_blank" rel="noopener noreferrer"> Mở CV </a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa có CV</span>
                                        }
                                    </td>

                                    <td>
                                        <form asp-controller="Employer" asp-action="ReviewApplication" method="post" class="ajax-review-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maDon" value="@don.MaDon" />

                                            <div class="mb-2">
                                                <label class="form-label">Trạng thái mới</label>
                                                <select name="maTrangThai" class="form-select" required>
                                                    <option value="2"
                                                        selected="@(don.MaTrangThai == 2)">
                                                        Đang xem xét
                                                    </option>

                                                    <option value="3"
                                                        selected="@(don.MaTrangThai == 3)">
                                                        Mời phỏng vấn
                                                    </option>

                                                    <option value="4"
                                                        selected="@(don.MaTrangThai == 4)">
                                                        Đạt
                                                    </option>

                                                    <option value="5"
                                                        selected="@(don.MaTrangThai == 5)">
                                                        Từ chối
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label">Thời gian phỏng vấn</label>
                                                <input type="datetime-local" name="thoiGianPhongVan" class="form-control" />
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label"> Địa điểm phỏng vấn </label>
                                                <input type="text" name="diaDiemPhongVan" class="form-control" maxlength="255" placeholder="Nhập địa điểm" />
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label"> Ghi chú nội bộ </label>
                                                <textarea name="ghiChuNoiBo" class="form-control" rows="2" maxlength="1000" placeholder="Ghi chú riêng của nhà tuyển dụng"></textarea>
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label">Phản hồi ứng viên</label>
                                                <textarea name="phanHoiUngVien" class="form-control" rows="2" maxlength="1000" placeholder="Nội dung phản hồi ứng viên"></textarea>
                                            </div>

                                            <button type="submit" class="btn btn-primary btn-sm"> Lưu xét duyệt </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).on('submit', '.ajax-review-form', function (event) {
            event.preventDefault();

            const form = $(this);
            const button = form.find('button[type="submit"]');
            const messageBox = $('#ajax-review-message');
            const statusSelect = form.find('select[name="maTrangThai"]');
            const maDon = form.find('input[name="maDon"]').val();
            const selectedStatus = statusSelect.val();

            button.prop('disabled', true).text('Đang lưu...');
            messageBox.removeClass('d-none alert-success alert-danger')
                     .addClass('alert-info').text('Đang lưu xét duyệt...');

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .done(function (response) {
                if (!response || !response.success) {
                    messageBox.removeClass('alert-info').addClass('alert-danger')
                             .text(response && response.message ? response.message : 'Không thể lưu xét duyệt.');
                    return;
                }

                const row = form.closest('tr');
                row.attr('data-application-status', response.maTrangThai);

                const badge = $('#status-' + maDon);
                badge.text(response.tenTrangThai)
                     .removeClass('bg-success bg-danger bg-info bg-warning text-dark bg-secondary');

                if (response.maTrangThai == 4) badge.addClass('bg-success');
                else if (response.maTrangThai == 5) badge.addClass('bg-danger');
                else if (response.maTrangThai == 3) badge.addClass('bg-info text-dark');
                else if (response.maTrangThai == 2) badge.addClass('bg-warning text-dark');
                else badge.addClass('bg-secondary');

                messageBox.removeClass('alert-info alert-danger')
                         .addClass('alert-success').text(response.message);
            })
            .fail(function (xhr) {
                const message = xhr.responseJSON && xhr.responseJSON.message
                    ? xhr.responseJSON.message
                    : 'Có lỗi xảy ra khi lưu xét duyệt. Vui lòng thử lại.';
                messageBox.removeClass('alert-info alert-success')
                         .addClass('alert-danger').text(message);
            })
            .always(function () {
                button.prop('disabled', false).text('Lưu xét duyệt');
            });
        });
    
        // AJAX: lọc hồ sơ ứng tuyển theo trạng thái từ server.
        $('#application-status-filter').on('change', function () {
            const status = $(this).val();
            const message = $('#application-filter-message');
            message.text('Đang lọc...');
            $.get('@Url.Action("FilterApplicationsAjax", "Employer", new { id = ViewBag.MaTin })',
                { status: status === '' ? null : status })
                .done(function (response) {
                    if (!response || !response.success) { message.text('Không lọc được hồ sơ.'); return; }
                    const allowed = new Set(response.applications.map(function (x) { return String(x.maDon); }));
                    $('tbody tr[data-application-status]').each(function () {
                        const row = $(this);
                        const maDon = row.find('input[name="maDon"]').val();
                        row.toggle(allowed.has(String(maDon)));
                    });
                    message.text('Đang hiển thị ' + response.count + ' hồ sơ.');
                })
                .fail(function () { message.text('Có lỗi khi lọc hồ sơ.'); });
        });
</script>
}