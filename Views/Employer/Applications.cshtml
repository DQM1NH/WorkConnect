 @model IEnumerable<WorkConnect.Models.Entities.DonUngTuyen>

@{
    ViewData["Title"] = "Hồ sơ ứng tuyển";
    ViewData["UseEmployerLayout"] = true;
    var tieuDeTin = ViewBag.TieuDeTin as string ?? "Tin tuyển dụng";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Hồ sơ ứng tuyển</h2>
            <p class="text-muted mb-0">@tieuDeTin</p>
        </div>

        <a asp-controller="Employer"
           asp-action="Jobs"
           class="btn btn-outline-secondary">
            Quay lại danh sách tin
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">
                Danh sách hồ sơ
                <span class="badge bg-primary">
                    @(Model?.Count() ?? 0)
                </span>
            </h5>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info mb-0">
                    Chưa có ứng viên nộp hồ sơ cho tin tuyển dụng này.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>STT</th>
                                <th>Ứng viên</th>
                                <th>Thông tin liên hệ</th>
                                <th>Ngày nộp</th>
                                <th>Trạng thái</th>
                                <th>CV</th>
                                <th style="min-width: 320px;">Xét duyệt</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var stt = 0;
                            }

                            @foreach (var don in Model)
                            {
                                stt++;

                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <strong>
                                            @(!string.IsNullOrWhiteSpace(don.HoTen)
                                                ? don.HoTen
                                                : don.UngVien?.HoTen ?? "Chưa cập nhật")
                                        </strong>

                                        <div class="small text-muted">
                                            Mã ứng viên: @don.MaUngVien
                                        </div>
                                    </td>

                                    <td>
                                        <div>
                                            @(!string.IsNullOrWhiteSpace(don.Email)
                                                ? don.Email
                                                : don.UngVien?.EmailLienHe ?? "Chưa có email")
                                        </div>

                                        <div class="small text-muted">
                                            @(!string.IsNullOrWhiteSpace(don.SoDienThoai)
                                                ? don.SoDienThoai
                                                : don.UngVien?.SoDienThoaiLienHe ?? "Chưa có số điện thoại")
                                        </div>
                                    </td>

                                    <td>
                                        @don.NgayNop.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <span class="badge
                                            @(don.MaTrangThai == 4 ? "bg-success" :
                                              don.MaTrangThai == 5 ? "bg-danger" :
                                              don.MaTrangThai == 3 ? "bg-info text-dark" :
                                              don.MaTrangThai == 2 ? "bg-warning text-dark" :
                                              "bg-secondary")">
                                            @(don.TrangThai?.TenTrangThai ?? "Chưa xác định")
                                        </span>
                                    </td>

                                    <td>
                                        @if (don.CV != null &&
                                             !string.IsNullOrWhiteSpace(don.CV.DuongDanTep))
                                        {
                                            <span>@don.CV.TenTep</span>
                                            <div>
                                                <a href="@don.CV.DuongDanTep"
                                                   target="_blank"
                                                   rel="noopener noreferrer">
                                                    Mở CV
                                                </a>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa có CV</span>
                                        }
                                    </td>

                                    <td>
                                        <form asp-controller="Employer"
                                              asp-action="ReviewApplication"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="maDon"
                                                   value="@don.MaDon" />

                                            <div class="mb-2">
                                                <label class="form-label">
                                                    Trạng thái mới
                                                </label>

                                                <select name="maTrangThai"
                                                        class="form-select"
                                                        required>
                                                    <option value="2"
                                                        selected="@(don.MaTrangThai == 2)">
                                                        Đang xem xét
                                                    </option>

                                                    <option value="3"
                                                        selected="@(don.MaTrangThai == 3)">
                                                        Mời phỏng vấn
                                                    </option>

                                                    <option value="4"
                                                        selected="@(don.MaTrangThai == 4)">
                                                        Đạt
                                                    </option>

                                                    <option value="5"
                                                        selected="@(don.MaTrangThai == 5)">
                                                        Từ chối
                                                    </option>
                                                </select>
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label">
                                                    Thời gian phỏng vấn
                                                </label>

                                                <input type="datetime-local"
                                                       name="thoiGianPhongVan"
                                                       class="form-control" />
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label">
                                                    Địa điểm phỏng vấn
                                                </label>

                                                <input type="text"
                                                       name="diaDiemPhongVan"
                                                       class="form-control"
                                                       maxlength="255"
                                                       placeholder="Nhập địa điểm" />
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label">
                                                    Ghi chú nội bộ
                                                </label>

                                                <textarea name="ghiChuNoiBo"
                                                          class="form-control"
                                                          rows="2"
                                                          maxlength="1000"
                                                          placeholder="Ghi chú riêng của nhà tuyển dụng"></textarea>
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label">
                                                    Phản hồi ứng viên
                                                </label>

                                                <textarea name="phanHoiUngVien"
                                                          class="form-control"
                                                          rows="2"
                                                          maxlength="1000"
                                                          placeholder="Nội dung phản hồi ứng viên"></textarea>
                                            </div>

                                            <button type="submit"
                                                    class="btn btn-primary btn-sm">
                                                Lưu xét duyệt
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
