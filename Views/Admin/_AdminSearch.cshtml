@model PagedResultBase

<form class="admin-search" method="get" action="@Url.Action("Index", "Admin")" role="search" data-admin-search data-tab="@Model.Tab" autocomplete="off">
    <input type="hidden" name="tab" value="@Model.Tab" />
    <i class="fa-solid fa-magnifying-glass admin-search-icon" aria-hidden="true"></i>
    <input type="search" class="admin-search-input" name="@Model.QueryKey" value="@Model.Search" maxlength="100"
           placeholder="@(ViewData["Placeholder"] as string ?? "Tìm kiếm...")" aria-label="@(ViewData["Placeholder"] as string ?? "Tìm kiếm")" />
    <button type="submit" class="btn-act btn-view admin-search-submit">Tìm</button>
</form>
