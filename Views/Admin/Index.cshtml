@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Trang quản trị - WorkConnect";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/fontawesome-free-6.6.0-web/css/all.min.css" />

<div class="admin-dashboard-container"
     data-index-url="@Url.Action("Index", "Admin")"
     data-login-url="@Url.Action("Login", "Account")"
     data-active-tab="@Model.ActiveTab">
    <div class="admin-header">
        <h1>Bảng điều khiển quản trị</h1>
        <p>TỔNG QUAN HỆ THỐNG VÀ QUẢN LÝ TẬP TRUNG</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="padding:12px 16px;margin-bottom:16px;border-radius:6px;background:#d4edda;color:#155724;">
            <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="padding:12px 16px;margin-bottom:16px;border-radius:6px;background:#f8d7da;color:#721c24;">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
        </div>
    }

    <!-- MODULE 1: THỐNG KÊ TỔNG QUAN -->
    <div class="stats-grid">
        <div class="stat-card border-blue">
            <div class="stat-icon icon-blue"><i class="fa-solid fa-users"></i></div>
            <div class="stat-info">
                <h3 id="stat-total-users">@Model.TotalUsers.ToString("N0")</h3>
                <p>Tổng người dùng</p>
            </div>
        </div>

        <div class="stat-card border-green">
            <div class="stat-icon icon-green"><i class="fa-solid fa-briefcase"></i></div>
            <div class="stat-info">
                <h3 id="stat-total-jobs">@Model.TotalJobs.ToString("N0")</h3>
                <p>Tin tuyển dụng</p>
            </div>
        </div>

        <div class="stat-card border-orange">
            <div class="stat-icon icon-orange"><i class="fa-solid fa-clock-rotate-left"></i></div>
            <div class="stat-info">
                <h3 id="stat-pending">@Model.PendingApprovals.ToString("N0")</h3>
                <p>Chờ duyệt nội dung</p>
            </div>
        </div>

        <div class="stat-card border-purple">
            <div class="stat-icon icon-purple"><i class="fa-solid fa-paper-plane"></i></div>
            <div class="stat-info">
                <h3 id="stat-total-applications">@Model.TotalApplications.ToString("N0")</h3>
                <p>Lượt ứng tuyển</p>
            </div>
        </div>
    </div>

    <!-- KHU VỰC TABS -->
    <div class="admin-content-card">
        <div class="tab-navigation">
            <button type="button" class="tab-btn @(Model.ActiveTab == "approval" ? "active" : "")" data-tab="approval" data-panel="tab-content-approval">
                <i class="fa-solid fa-circle-check"></i> Duyệt nội dung <span class="badge-count" id="badge-pending">@Model.PendingApprovals</span>
            </button>
            <button type="button" class="tab-btn @(Model.ActiveTab == "users" ? "active" : "")" data-tab="users" data-panel="tab-user-management">
                <i class="fa-solid fa-user-gear"></i> Quản lý người dùng
            </button>
            <button type="button" class="tab-btn @(Model.ActiveTab == "content" ? "active" : "")" data-tab="content" data-panel="tab-content-management">
                <i class="fa-solid fa-user-gear"></i> Quản lý bài đăng
            </button>
            <button type="button" class="tab-btn @(Model.ActiveTab == "applications" ? "active" : "")" data-tab="applications" data-panel="tab-applications">
                <i class="fa-solid fa-paper-plane"></i> Đơn ứng tuyển
            </button>
        </div>

        <!-- Module: Duyệt bài đăng -->
        <div id="tab-content-approval" class="tab-content @(Model.ActiveTab == "approval" ? "active" : "")">
            @await Html.PartialAsync("_AdminSearch", Model.PendingJobs, new ViewDataDictionary(ViewData) { { "Placeholder", "Tìm theo tiêu đề, nhà tuyển dụng, ngành nghề..." } })
            <div class="tab-body" id="body-approval" data-tab="approval" aria-live="polite">
                @await Html.PartialAsync("_AdminTabBody", Model, new ViewDataDictionary(ViewData) { { "Tab", "approval" } })
            </div>
        </div>

        <!-- Module Quản lý người dùng -->
        <div id="tab-user-management" class="tab-content @(Model.ActiveTab == "users" ? "active" : "")">
            @await Html.PartialAsync("_AdminSearch", Model.Users, new ViewDataDictionary(ViewData) { { "Placeholder", "Tìm theo tên, email, mã USR hoặc vai trò..." } })
            <div class="tab-body" id="body-users" data-tab="users" aria-live="polite">
                @await Html.PartialAsync("_AdminTabBody", Model, new ViewDataDictionary(ViewData) { { "Tab", "users" } })
            </div>
        </div>

        <!-- Module: Quản lý bài đăng -->
        <div id="tab-content-management" class="tab-content @(Model.ActiveTab == "content" ? "active" : "")">
            @await Html.PartialAsync("_AdminSearch", Model.Content, new ViewDataDictionary(ViewData) { { "Placeholder", "Tìm theo tiêu đề hoặc nhà tuyển dụng..." } })
            <div class="tab-body" id="body-content" data-tab="content" aria-live="polite">
                @await Html.PartialAsync("_AdminTabBody", Model, new ViewDataDictionary(ViewData) { { "Tab", "content" } })
            </div>
        </div>

        <!-- Module Đơn ứng tuyển -->
        <div id="tab-applications" class="tab-content @(Model.ActiveTab == "applications" ? "active" : "")">
            @await Html.PartialAsync("_AdminSearch", Model.Applications, new ViewDataDictionary(ViewData) { { "Placeholder", "Tìm theo mã đơn, ứng viên, email, SĐT, vị trí..." } })
            <div class="tab-body" id="body-applications" data-tab="applications" aria-live="polite">
                @await Html.PartialAsync("_AdminTabBody", Model, new ViewDataDictionary(ViewData) { { "Tab", "applications" } })
            </div>
        </div>
    </div>
</div>

<div id="adminToasts" class="admin-toasts" aria-live="polite" aria-atomic="false"></div>

<!-- Modal xem chi tiết tin tuyển dụng -->
<div id="jobDetailModal" class="job-modal-overlay" aria-hidden="true">
    <div class="job-modal" role="dialog" aria-modal="true" aria-labelledby="jobDetailModalTitle">
        <div class="job-modal-header">
            <h3 id="jobDetailModalTitle">Chi tiết tin tuyển dụng</h3>
            <button type="button" class="job-modal-close" data-modal-close aria-label="Đóng">&times;</button>
        </div>
        <div class="job-modal-body" id="jobDetailModalBody"></div>
        <div class="job-modal-footer">
            <button type="button" class="btn-act btn-lock" data-modal-close>Đóng</button>

            <form asp-action="RejectJob" method="post" data-ajax-action data-confirm="Xác nhận từ chối tin này?">
                <input type="hidden" name="id" class="job-modal-id" />
                <button type="submit" class="btn-act btn-reject">
                    <i class="fa-solid fa-xmark"></i> Từ chối
                </button>
            </form>

            <form asp-action="ApproveJob" method="post" data-ajax-action data-confirm="Xác nhận duyệt tin này?">
                <input type="hidden" name="id" class="job-modal-id" />
                <button type="submit" class="btn-act btn-approve">
                    <i class="fa-solid fa-check"></i> Duyệt
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
