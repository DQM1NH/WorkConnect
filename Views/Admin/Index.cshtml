@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Trang quản trị - WorkConnect";
}

<link rel="stylesheet" href="~/css/admin.css" />
<link rel="stylesheet" href="~/css/fontawesome-free-6.6.0-web/css/all.min.css" />

<div class="admin-dashboard-container">
    <div class="admin-header">
        <h1>Bảng điều khiển quản trị</h1>
        <p>TỔNG QUAN HỆ THỐNG VÀ QUẢN LÝ TẬP TRUNG</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="padding:12px 16px;margin-bottom:16px;border-radius:6px;background:#d4edda;color:#155724;">
            <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="padding:12px 16px;margin-bottom:16px;border-radius:6px;background:#f8d7da;color:#721c24;">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]
        </div>
    }

    <!-- MODULE 1: THỐNG KÊ TỔNG QUAN (ĐÃ KẾT NỐI CSDL) -->
    <div class="stats-grid">
        <div class="stat-card border-blue">
            <div class="stat-icon icon-blue"><i class="fa-solid fa-users"></i></div>
            <div class="stat-info">
                <h3>@Model.TotalUsers.ToString("N0")</h3>
                <p>Tổng người dùng</p>
            </div>
        </div>

        <div class="stat-card border-green">
            <div class="stat-icon icon-green"><i class="fa-solid fa-briefcase"></i></div>
            <div class="stat-info">
                <h3>@Model.TotalJobs.ToString("N0")</h3>
                <p>Tin tuyển dụng</p>
            </div>
        </div>

        <div class="stat-card border-orange">
            <div class="stat-icon icon-orange"><i class="fa-solid fa-clock-rotate-left"></i></div>
            <div class="stat-info">
                <h3>@Model.PendingApprovals.ToString("N0")</h3>
                <p>Chờ duyệt nội dung</p>
            </div>
        </div>

        <div class="stat-card border-purple">
            <div class="stat-icon icon-purple"><i class="fa-solid fa-paper-plane"></i></div>
            <div class="stat-info">
                <h3>@Model.TotalApplications.ToString("N0")</h3>
                <p>Lượt ứng tuyển</p>
            </div>
        </div>
    </div>

    <!-- KHU VỰC TABS -->
    <div class="admin-content-card">
        <div class="tab-navigation">
            <button class="tab-btn @(Model.ActiveTab == "approval" ? "active" : "")" onclick="switchTab(event, 'tab-content-approval', 'approval')">
                <i class="fa-solid fa-circle-check"></i> Duyệt nội dung <span class="badge-count">@Model.PendingApprovals</span>
            </button>
            <button class="tab-btn @(Model.ActiveTab == "users" ? "active" : "")" onclick="switchTab(event, 'tab-user-management', 'users')">
                <i class="fa-solid fa-user-gear"></i> Quản lý người dùng
            </button>
            <button class="tab-btn @(Model.ActiveTab == "content" ? "active" : "")" onclick="switchTab(event, 'tab-content-management', 'content')">
                <i class="fa-solid fa-user-gear"></i> Quản lý bài đăng
            </button>
            <button class="tab-btn @(Model.ActiveTab == "applications" ? "active" : "")" onclick="switchTab(event, 'tab-applications', 'applications')">
                <i class="fa-solid fa-paper-plane"></i> Đơn ứng tuyển
            </button>
        </div>

        <!-- Module: Duyệt bài đăng -->
        <div id="tab-content-approval" class="tab-content @(Model.ActiveTab == "approval" ? "active" : "")">
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Tiêu đề tin</th>
                            <th>Nhà tuyển dụng</th>
                            <th>Ngày đăng</th>
                            <th>Ngành nghề</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.PendingJobs.Items.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">@(Model.PendingJobs.HasSearch ? "Không tìm thấy tin nào phù hợp." : "Không có tin tuyển dụng nào chờ duyệt.")</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var job in Model.PendingJobs.Items)
                            {
                                <tr>
                                    <td>
                                        <strong>@job.Title</strong>
                                        <br /><small class="text-muted">Mức lương: @job.SalaryRange</small>
                                    </td>
                                    <td>@job.EmployerName</td>
                                    <td>@job.PostedDate.ToString("dd/MM/yyyy")</td>
                                    <td><span class="category-tag">@job.Category</span></td>
                                    <td><span class="badge badge-pending">Chờ duyệt</span></td>
                                    <td class="action-buttons text-center">
                                        <button type="button" class="btn-act btn-view" onclick="openJobDetail(@job.JobId)">
                                            <i class="fa-solid fa-eye"></i> Xem chi tiết
                                        </button>

                                        @* Nội dung chi tiết (đã được Razor encode) - modal sẽ lấy từ đây *@
                                        <template id="job-detail-@job.JobId">
                                            <h4 class="job-detail-title">@job.Title</h4>
                                            <span class="badge badge-pending">Chờ duyệt</span>

                                            <div class="job-detail-grid">
                                                <div class="job-detail-item"><small>Nhà tuyển dụng</small><span>@job.EmployerName</span></div>
                                                <div class="job-detail-item"><small>Ngành nghề</small><span>@job.Category</span></div>
                                                <div class="job-detail-item"><small>Vị trí</small><span>@(string.IsNullOrWhiteSpace(job.Position) ? "Chưa cập nhật" : job.Position)</span></div>
                                                <div class="job-detail-item"><small>Địa điểm</small><span>@job.Location</span></div>
                                                <div class="job-detail-item"><small>Mức lương</small><span>@job.SalaryRange</span></div>
                                                <div class="job-detail-item"><small>Số lượng tuyển</small><span>@job.Quantity</span></div>
                                                <div class="job-detail-item"><small>Ngày đăng</small><span>@job.PostedDate.ToString("dd/MM/yyyy")</span></div>
                                                <div class="job-detail-item"><small>Hạn ứng tuyển</small><span>@job.Deadline.ToString("dd/MM/yyyy")</span></div>
                                                @if (!string.IsNullOrWhiteSpace(job.EmployerAddress))
                                                {
                                                    <div class="job-detail-item" style="grid-column: 1 / -1;"><small>Địa chỉ công ty</small><span>@job.EmployerAddress</span></div>
                                                }
                                            </div>

                                            <div class="job-detail-section">
                                                <h4>Mô tả công việc</h4>
                                                <div class="job-detail-text">@(string.IsNullOrWhiteSpace(job.Description) ? "Chưa có mô tả." : job.Description)</div>
                                            </div>
                                            <div class="job-detail-section">
                                                <h4>Yêu cầu công việc</h4>
                                                <div class="job-detail-text">@(string.IsNullOrWhiteSpace(job.Requirements) ? "Chưa có yêu cầu." : job.Requirements)</div>
                                            </div>
                                        </template>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <!-- Phân trang -->
            @await Html.PartialAsync("_AdminPager", Model.PendingJobs)
        </div>

        <!-- Module Quản lý người dùng -->
        <div id="tab-user-management" class="tab-content @(Model.ActiveTab == "users" ? "active" : "")">
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Ngày tham gia</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Users.Items.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">@(Model.Users.HasSearch ? "Không tìm thấy người dùng nào phù hợp." : "Chưa có người dùng nào.")</td>
                            </tr>
                        }
                        @foreach (var user in Model.Users.Items)
                        {
                            <tr>
                                <td>
                                    <div class="user-info-cell">
                                        <div class="user-avatar @(user.Role == "Nhà tuyển dụng" ? "avatar-emp" : "")">
                                            @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <strong>@user.FullName</strong>
                                            <br /><small class="text-muted">ID: @user.UserId</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="role-tag @(user.Role == "Nhà tuyển dụng" ? "role-employer" : "role-candidate")">
                                        @user.Role
                                    </span>
                                </td>
                                <td>@user.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge badge-active">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending" style="background:#f8d7da; color:#721c24;">Bị khóa</span>
                                    }
                                </td>
                                <td class="action-buttons text-center">
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                    <form asp-action="ToggleUserLock" asp-route-id="@user.RawId" method="post" style="display:inline;" onsubmit="return confirm('@(user.IsActive ? "Khóa tài khoản này?" : "Mở khóa tài khoản này?")');">
                                        <input type="hidden" name="returnUrl" />
                                        <button type="submit" class="btn-act btn-lock">
                                            <i class="fa-solid @(user.IsActive ? "fa-lock" : "fa-lock-open")"></i> @(user.IsActive ? "Khóa" : "Mở khóa")
                                        </button>
                                    </form>
                                    <form asp-action="DeleteAccount" asp-route-id="@user.RawId" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này không?');">
                                        <input type="hidden" name="returnUrl" />
                                        <button type="submit" class="btn-act btn-delete">
                                            <i class="fa-solid fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <!-- Phân trang -->
            @await Html.PartialAsync("_AdminPager", Model.Users)
        </div>

        <!-- Module: Quản lý bài đăng -->
        <div id="tab-content-management" class="tab-content @(Model.ActiveTab == "content" ? "active" : "")">
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Nhà tuyển dụng</th>
                            <th>Tiêu đề</th>
                            <th>Mức lương</th>
                            <th>Số lượng</th>
                            <th>Ngày đăng</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Content.Items.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">@(Model.Content.HasSearch ? "Không tìm thấy bài đăng nào phù hợp." : "Chưa có bài đăng nào.")</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var content in Model.Content.Items)
                            {
                                <tr>
                                    <td>@content.EmployerName</td>
                                    <td>
                                        <strong>@content.Title</strong>
                                        @if (content.IsHidden)
                                        {
                                            <span class="badge" style="background:#e2e3e5; color:#383d41; margin-left:6px;">Đã ẩn</span>
                                        }
                                    </td>
                                    <td>@content.Salary</td>
                                    <td>@content.Quantity</td>
                                    <td>@content.PostedDate.ToString("dd/MM/yyyy")</td>
                                    <td class="action-buttons text-center">
                                        <form asp-action="ToggleJobVisibility" asp-route-id="@content.JobId" method="post" style="display:inline;">
                                        <input type="hidden" name="returnUrl" />
                                            <button type="submit" class="btn-act btn-lock" onclick="return confirm('@(content.IsHidden ? "Hiện lại bài đăng này?" : "Ẩn bài đăng này?")')">
                                                <i class="fa-solid @(content.IsHidden ? "fa-eye" : "fa-eye-slash")"></i> @(content.IsHidden ? "Hiện" : "Ẩn")
                                            </button>
                                        </form>

                                        <form asp-action="DeleteJob" asp-route-id="@content.JobId" method="post" style="display:inline;">
                                        <input type="hidden" name="returnUrl" />
                                            <button type="submit" class="btn-act btn-delete" onclick="return confirm('Bạn có chắc chắn muốn xóa bài đăng này không? Hành động này có thể không khôi phục được!')">
                                                <i class="fa-solid fa-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <!-- Phân trang -->
            @await Html.PartialAsync("_AdminPager", Model.Content)
        </div>

        <!-- Module Đơn ứng tuyển -->
        <div id="tab-applications" class="tab-content @(Model.ActiveTab == "applications" ? "active" : "")">
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Ứng viên</th>
                            <th>Liên hệ</th>
                            <th>Vị trí ứng tuyển</th>
                            <th>Nhà tuyển dụng</th>
                            <th>Ngày nộp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Applications.Items.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">@(Model.Applications.HasSearch ? "Không tìm thấy đơn ứng tuyển nào phù hợp." : "Chưa có đơn ứng tuyển nào.")</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var app in Model.Applications.Items)
                            {
                                <tr>
                                    <td>#@app.ApplicationId</td>
                                    <td>
                                        <div class="user-info-cell">
                                            <div class="user-avatar">@app.CandidateName.Substring(0, 1).ToUpper()</div>
                                            <strong>@app.CandidateName</strong>
                                        </div>
                                    </td>
                                    <td>
                                        @app.CandidateEmail
                                        @if (!string.IsNullOrWhiteSpace(app.CandidatePhone))
                                        {
                                            <br /><small class="text-muted">@app.CandidatePhone</small>
                                        }
                                    </td>
                                    <td><strong>@app.JobTitle</strong></td>
                                    <td>@app.EmployerName</td>
                                    <td>@app.AppliedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <!-- Phân trang -->
            @await Html.PartialAsync("_AdminPager", Model.Applications)
        </div>
    </div>
</div>

<!-- Modal xem chi tiết tin tuyển dụng -->
<div id="jobDetailModal" class="job-modal-overlay" aria-hidden="true">
    <div class="job-modal" role="dialog" aria-modal="true" aria-labelledby="jobDetailModalTitle">
        <div class="job-modal-header">
            <h3 id="jobDetailModalTitle">Chi tiết tin tuyển dụng</h3>
            <button type="button" class="job-modal-close" onclick="closeJobDetail()" aria-label="Đóng">&times;</button>
        </div>
        <div class="job-modal-body" id="jobDetailModalBody"></div>
        <div class="job-modal-footer">
            <button type="button" class="btn-act btn-lock" onclick="closeJobDetail()">Đóng</button>

            <form asp-action="RejectJob" method="post">
                <input type="hidden" name="id" class="job-modal-id" />
                <input type="hidden" name="returnUrl" />
                <button type="submit" class="btn-act btn-reject" onclick="return confirm('Xác nhận từ chối tin này?')">
                    <i class="fa-solid fa-xmark"></i> Từ chối
                </button>
            </form>

            <form asp-action="ApproveJob" method="post">
                <input type="hidden" name="id" class="job-modal-id" />
                <input type="hidden" name="returnUrl" />
                <button type="submit" class="btn-act btn-approve" onclick="return confirm('Xác nhận duyệt tin này?')">
                    <i class="fa-solid fa-check"></i> Duyệt
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function switchTab(evt, tabName, tabKey) {
        document.querySelectorAll(".tab-content").forEach(t => t.classList.remove("active"));
        document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
        document.getElementById(tabName).classList.add("active");
        evt.currentTarget.classList.add("active");

        const url = new URL(window.location.href);
        url.searchParams.set("tab", tabKey);
        history.replaceState(null, "", url);
    }

    const jobModal = document.getElementById("jobDetailModal");

    function openJobDetail(jobId) {
        const tpl = document.getElementById("job-detail-" + jobId);
        if (!tpl) return;
        document.getElementById("jobDetailModalBody").replaceChildren(tpl.content.cloneNode(true));
        jobModal.querySelectorAll(".job-modal-id").forEach(i => i.value = jobId);
        jobModal.classList.add("open");
        jobModal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
    }

    function closeJobDetail() {
        jobModal.classList.remove("open");
        jobModal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    jobModal.addEventListener("click", function (e) {
        if (e.target === jobModal) closeJobDetail();
    });
    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && jobModal.classList.contains("open")) closeJobDetail();
    });

    document.addEventListener("submit", function (e) {
        const field = e.target.querySelector && e.target.querySelector('input[name="returnUrl"]');
        if (field) field.value = window.location.pathname + window.location.search;
    }, true);
</script>
