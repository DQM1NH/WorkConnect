<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkConnect</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorkConnect.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header">
        <div class="header-container">
            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="brand-logo">
                Work<span>Connect</span>
            </a>

            <!-- Menu -->
            <nav class="main-nav">
                <ul>
                    <li><a asp-controller="Job" asp-action="Index">Tìm Việc Làm</a></li>
                    <li><a asp-controller="CV" asp-action="Index">CVHay</a></li>
                    <li><a asp-controller="Salary" asp-action="Index">VietnamSalary</a></li>
                    <li><a asp-controller="CareerMap" asp-action="Index">CareerMap</a></li>
                    <li><a asp-controller="Blog" asp-action="Index">Cẩm Nang</a></li>
                    <li><a asp-controller="Tools" asp-action="Index">Tiện Ích</a></li>
                </ul>
            </nav>

            
        <div class="header-actions">
            <a href="#" class="nav-action-item">
                <i class="fa-regular fa-bell"></i> Thông Báo Việc Làm
            </a>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <span class="nav-action-item">
                    <i class="fa-regular fa-user"></i>
                    Xin chào, @User.Identity.Name
                </span>

                <form asp-controller="Account"
                    asp-action="Logout"
                    method="post"
                    style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-action-item"
                            style="background: none; border: none; cursor: pointer;">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Đăng xuất
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login"
                class="nav-action-item">
                    <i class="fa-regular fa-user"></i> Đăng nhập
                </a>

                <a asp-controller="Account" asp-action="Register"
                class="nav-action-item">
                    Đăng ký
                </a>
            }
        </div>

        </div>
    </header>
    @if (ViewData["UseEmployerLayout"] as bool? == true)
    {
        <div class="employer-shell">
            <aside class="employer-sidebar">
                <div class="employer-menu-title">
                    MENU NHÀ TUYỂN DỤNG
                </div>

                
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isJobsPage = currentController == "Employer"
        && new[] { "Jobs", "Create", "Edit", "JobDetails", "Details", "Delete" }
            .Contains(currentAction);
}

        <nav class="employer-menu">
            <a asp-controller="Employer"
            asp-action="Index"
            class="@(currentController == "Employer" && currentAction == "Index" ? "active" : "")">
                ▦ &nbsp; Tổng quan
            </a>

            <a asp-controller="Employer"
            asp-action="Jobs"
            class="@(isJobsPage ? "active" : "")">
                ▤ &nbsp; Tin tuyển dụng
            </a>

            <a asp-controller="Employer"
            asp-action="Jobs"
            class="@(currentController == "Employer" && currentAction == "Candidates" ? "active" : "")">
                ♙ &nbsp; Ứng viên
            </a>

            <a asp-controller="Employer"
            asp-action="Index"
            class="@(currentController == "Employer" && currentAction == "CompanyProfile" ? "active" : "")">
                ▧ &nbsp; Hồ sơ công ty
            </a>

            <a asp-controller="Employer"
            asp-action="Index"
            class="@(currentController == "Employer" && currentAction == "Settings" ? "active" : "")">
                ⚙ &nbsp; Cài đặt
            </a>
        </nav>


                <div class="employer-sidebar-bottom">
                    Tài khoản nhà tuyển dụng
                </div>
            </aside>

            <main class="employer-main">
                <div class="employer-content">
                    @RenderBody()
                </div>
            </main>
        </div>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <h2 class="footer-logo">Work<span>Connect</span></h2>
                <p class="footer-tagline">LEADING THE HUMAN RESOURCES INDUSTRY</p>
            </div>

            <div class="footer-links-grid">
                <div class="footer-col">
                    <h4>DÀNH CHO ỨNG VIÊN</h4>
                    <ul>
                        <li><a href="#">Việc làm mới nhất</a></li>
                        <li><a href="#">CVHay</a></li>
                        <li><a href="#">VietnamSalary</a></li>
                        <li><a href="#">Cẩm Nang</a></li>
                        <li><a href="#">Ứng Dụng Di Động</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>NHÀ TUYỂN DỤNG</h4>
                    <ul>
                        <li><a href="#">Đăng Tuyển Dụng</a></li>
                        <li><a href="#">Tìm Hồ Sơ</a></li>
                        <li><a href="#">Giải Pháp Talent Solution</a></li>
                        <li><a href="#">Sản Phẩm Dịch Vụ</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>TRUNG TÂM TRỢ GIÚP</h4>
                    <ul>
                        <li><a href="#">Về WorkConnect</a></li>
                        <li><a href="#">Chính Sách BV Thông Tin</a></li>
                        <li><a href="#">Điều khoản sử dụng</a></li>
                        <li><a href="#">Chính sách quyền riêng tư</a></li>
                        <li><a href="#">Trợ giúp</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>XÂY DỰNG SỰ NGHIỆP</h4>
                    <ul>
                        <li><a href="#">Freelancer</a></li>
                        <li><a href="#">Thiết kế nội thất</a></li>
                        <li><a href="#">Digital marketing</a></li>
                        <li><a href="#">Telesale</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>TÌM KIẾM MỌI LÚC MỌI NƠI</h4>
                    <div class="app-buttons">
                        <a href="#" class="btn-app"><i class="fa-brands fa-apple"></i> App Store</a>
                        <a href="#" class="btn-app"><i class="fa-brands fa-google-play"></i> Google Play</a>
                    </div>
                    <h4 style="margin-top: 15px;">KẾT NỐI VỚI WORKCONNECT</h4>
                    <div class="social-icons">
                        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>Trụ sở: Tòa nhà WorkConnect, TP. Hà Nội, Việt Nam</p>
                <p>Email: contact@workconnect.vn | Copyright © WorkConnect Corporation</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
