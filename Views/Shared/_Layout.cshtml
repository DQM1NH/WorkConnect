<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkConnect</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/fontawesome-free-6.6.0-web/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorkConnect.styles.css" asp-append-version="true" />
    @if (ViewData["Description"] is string desc) { <meta name="description" content="@desc" /> }
</head>
<body>
    <header class="main-header">
        <div class="header-container">
            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="brand-logo">
                Work<span>Connect</span>
            </a>

            <!-- Menu -->
            <nav class="main-nav">
    <ul>
        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li><a asp-controller="Job" asp-action="Index">Tìm Việc Làm</a></li>
        <li><a asp-controller="Employer" asp-action="Index">Nhà Tuyển Dụng</a></li>
        @if (User.IsInRole("Candidate"))
        {
            <li><a asp-controller="Candidate" asp-action="Profile">Hồ Sơ</a></li>
            <li><a asp-controller="Candidate" asp-action="Cv">CV Của Tôi</a></li>
            <li><a asp-controller="Candidate" asp-action="Applications">Đơn Ứng Tuyển</a></li>
        }
    </ul>
</nav>

            <div class="header-actions">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <span class="nav-action-item"><i class="fa-regular fa-user"></i> @User.Identity.Name</span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="nav-action-item border-0 bg-transparent">Đăng xuất</button>
        </form>
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="nav-action-item"><i class="fa-regular fa-user"></i> Đăng nhập</a>
        <a asp-controller="Account" asp-action="Register" class="nav-action-item">Đăng ký</a>
    }
</div>
        </div>
    </header>
    <div class="container">
        @if (TempData["Success"] is string ok) { <div class="alert alert-success mt-3">@ok</div> }
@if (TempData["Error"] is string er) { <div class="alert alert-danger mt-3">@er</div> }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <h2 class="footer-logo">Work<span>Connect</span></h2>
                <p class="footer-tagline">LEADING THE HUMAN RESOURCES INDUSTRY</p>
            </div>

            <div class="footer-links-grid">
                <div class="footer-col">
                    <h4>DÀNH CHO ỨNG VIÊN</h4>
                    <ul>
                        <li><a href="#">Việc làm mới nhất</a></li>
                        <li><a href="#">CVHay</a></li>
                        <li><a href="#">VietnamSalary</a></li>
                        <li><a href="#">Cẩm Nang</a></li>
                        <li><a href="#">Ứng Dụng Di Động</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>NHÀ TUYỂN DỤNG</h4>
                    <ul>
                        <li><a href="#">Đăng Tuyển Dụng</a></li>
                        <li><a href="#">Tìm Hồ Sơ</a></li>
                        <li><a href="#">Giải Pháp Talent Solution</a></li>
                        <li><a href="#">Sản Phẩm Dịch Vụ</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>TRUNG TÂM TRỢ GIÚP</h4>
                    <ul>
                        <li><a href="#">Về WorkConnect</a></li>
                        <li><a href="#">Chính Sách BV Thông Tin</a></li>
                        <li><a href="#">Điều khoản sử dụng</a></li>
                        <li><a href="#">Chính sách quyền riêng tư</a></li>
                        <li><a href="#">Trợ giúp</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>XÂY DỰNG SỰ NGHIỆP</h4>
                    <ul>
                        <li><a href="#">Freelancer</a></li>
                        <li><a href="#">Thiết kế nội thất</a></li>
                        <li><a href="#">Digital marketing</a></li>
                        <li><a href="#">Telesale</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>TÌM KIẾM MỌI LÚC MỌI NƠI</h4>
                    <div class="app-buttons">
                        <a href="#" class="btn-app"><i class="fa-brands fa-apple"></i> App Store</a>
                        <a href="#" class="btn-app"><i class="fa-brands fa-google-play"></i> Google Play</a>
                    </div>
                    <h4 style="margin-top: 15px;">KẾT NỐI VỚI WORKCONNECT</h4>
                    <div class="social-icons">
                        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>Trụ sở: Tòa nhà WorkConnect, TP. Hà Nội, Việt Nam</p>
                <p>Email: contact@workconnect.vn | Copyright © WorkConnect Corporation</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
